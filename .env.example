# Google Gemini API key (Get a free API key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: preferred Gemini model (defaults to gemini-2.5-flash with fallbacks)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Server port (defaults to 3000)
# PORT=3000

# Optional: Allowed CORS origin (defaults to *)
# ALLOWED_ORIGIN=*

# Optional: AI requests per IP per hour (defaults to 30)
# RATE_LIMIT_PER_HOUR=30

# Optional: Upstash Redis for distributed rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
